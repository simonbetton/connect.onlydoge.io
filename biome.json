{
  "$schema": "./node_modules/biome/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.output",
      "!.agents",
      "!.tanstack",
      "!src/routeTree.gen.ts",
      "!public/favicon.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  },
  "tailwind": {
    "stylesheet": "./src/styles.css"
  },
  "markdown": {
    "formatter": {
      "formatEmbeds": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
