{
  "name": "onlydoge-dogeconnect-debugger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "bun run canonical && biome check --write .",
    "canonical": "bunx @laststance/tailwind-suggest-canonical-classes \"src/**/*.{tsx,jsx,ts,js,html}\"",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor --yes --no-telemetry",
    "doctor:staged": "react-doctor --staged --yes --no-telemetry --blocking error",
    "doctor:ci": "react-doctor --yes --no-telemetry --blocking error",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elysiajs/openapi": "^1.4.17",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tanstack/react-form": "^1.33.6",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.32",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@rolldown/plugin-transform-imports": "^0.1.3",
    "@shikijs/types": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "nitro": "^3.0.261103-rc",
    "react-doctor": "^0.9.23",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
